<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".LeyaaApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <activity
            android:name=".SplashScreen"
            android:theme="@style/Theme.App.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginPage"/>
        <activity android:name=".RoomListActivity"/>
        <activity android:name=".Registration"/>

        <activity android:name=".InvitationListActivity"/>
        <activity android:name=".Room_Creation" />
        <activity android:name=".Inside_Room_Activity" />
        <activity android:name=".RoomRemindersActivity" />
        <activity android:name=".RoomChoresActivity" />
        <activity android:name=".RoomNoticeBoardActivity" />
        <activity android:name=".ThreadedDiscussionActivity" />
        <activity android:name=".EditRoomName" />
        <activity android:name=".ProfilenameChange" />
        <activity android:name=".ProfilePage" />
        <activity android:name=".RoomMemberInfo"/>
        <activity android:name=".MemberAdd"/>
        <activity android:name=".Edit_Item"/>
        <activity android:name=".Add_Item" />

        <activity android:name=".SplitBill_Member_Info"/>
        <activity android:name=".Split_Add_Bill"/>
        <activity android:name=".Bill_Transaction"/>

        <!-- ✅ FIX: add "." -->
        <activity
            android:name=".Alarm_MainActivity"
            android:exported="true" />

        <!-- ✅ FIX: add "." and correct parentActivityName -->
        <activity
            android:name=".AddReminderActivity"
            android:label="@string/title_activity_add_reminder"
            android:parentActivityName=".Alarm_MainActivity"
            android:theme="@style/AppTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Alarm_MainActivity"/>
        </activity>

        <provider
            android:name=".data.AlarmReminderProvider"
            android:authorities="com.vijaykumawat.Leyaa"
            android:exported="false" />

        <!-- ✅ FIX: Use broadcast receiver for alarms to avoid Android 12+ background limits -->
        <receiver
            android:name=".reminder.ReminderAlarmReceiver"
            android:exported="false" />


        <activity android:name=".ChatRoom"/>

        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>



        <service
            android:name="com.vijaykumawat.Leyaa.NotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE">
        </service>


        <receiver android:name="com.vijaykumawat.Leyaa.NotificationReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


    </application>
</manifest>
